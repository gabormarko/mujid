    <key name="closetoinsert" qpos="-0.01424785  0.40787682  0.01460885 -2.03185782 -0.00897321  2.4396759 0.79141264" 
    ctrl="4.98090516e-04 -3.99006758e+01  5.39132841e-01  1.95803912e+01 5.11892491e-01  2.17301740e+00 -1.20123585e-04"/>
