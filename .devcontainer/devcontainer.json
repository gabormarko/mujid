{
    "name": "Mujid",
    "privileged": true,
    "remoteUser": "user",
    "dockerComposeFile": "../docker-compose.yaml",
    "workspaceFolder": "/home/user/mujid",
    "service": "mujid",
    "features": {
        "ghcr.io/duduribeiro/devcontainer-features/neovim:1": {
            "version": "stable"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/larsnieuwenhuizen/features/zellij:0": {
            "version": "0.0.4"
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/home/user/mujid,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.env,target=/home/user/.env,type=bind,consistency=cached"
    ],
    "postCreateCommand": "/bin/bash /home/user/mujid/.devcontainer/post_create.sh"
}
